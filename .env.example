APP_NAME=ShopEase Authentication Service
APP_ENV=development
APP_PORT=8002

DB_HOST=mysql
DB_PORT=3306
DB_NAME=shopease_auth_db
DB_USER=auth_user
DB_PASSWORD=replace_with_database_password

MYSQL_ROOT_PASSWORD=replace_with_root_password

JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEFAULT_USER_ROLE=customer
